# ============================================================
# .env.example — Copy to .env for local development
# NEVER commit .env to source control!
# ============================================================

# ---- Spring Profile ----
# Use 'tidb' to connect to TiDB Cloud (default in application.properties)
# Use 'dev'  to use the local H2 in-memory database (zero setup)
# Use 'prod' to use the production-hardened TiDB/MySQL config
SPRING_PROFILES_ACTIVE=tidb

# ---- TiDB Cloud Connection ----
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=hospitaldb
DB_USERNAME=ihDxZZQduC2Cg1p.root
DB_PASSWORD=your_password_here

# ---- Optional: override with full JDBC URL (used by prod profile) ----
# DATABASE_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/sys?sslMode=VERIFY_IDENTITY&useSSL=true&requireSSL=true&serverTimezone=UTC

# ---- For prod profile ----
DB_USERNAME=ihDxZZQduC2Cg1p.root

# ---- Server port (most PaaS platforms inject PORT automatically) ----
PORT=8080

# ---- HikariCP pool size (optional, default: 5) ----
# DB_POOL_SIZE=5
